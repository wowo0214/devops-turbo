{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**",
    "dist",
    "src/**",
    "components/**",
    "auth/**"
  ],
  "exports": {
    "./counter-button": {
      "import": {
        "types": "./dist/es/counter-button.d.mts",
        "default": "./dist/es/counter-button.mjs"
      },
      "require": {
        "types": "./dist/cjs/counter-button.d.ts",
        "default": "./dist/cjs/counter-button.js"
      }
    },
    "./link": {
      "import": {
        "types": "./dist/es/link.d.mts",
        "default": "./dist/es/link.mjs"
      },
      "require": {
        "types": "./dist/cjs/link.d.ts",
        "default": "./dist/cjs/link.js"
      }
    },
    "./components/*": "./components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles/globals.css",
    "./auth/*": "./auth/*.tsx",
    "./auth/lib/*": "./auth/lib/*.ts",
    "./auth/use-is-hydrated": "./auth/use-is-hydrated.ts",
    "./auth/lib/auth-plugin": "./auth/lib/auth-plugin.ts",
    "./auth/lib/is-email-validation-error": "./auth/lib/is-email-validation-error.ts",
    "./auth/lib/theme-plugin": "./auth/lib/theme-plugin.ts",
    "./auth/lib/two-factor-methods": "./auth/lib/two-factor-methods.ts",
    "./auth/lib/use-sign-in-continuation": "./auth/lib/use-sign-in-continuation.ts"
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/ components/ auth/",
    "test": "jest"
  },
  "devDependencies": {
    "@jest/globals": "30.5.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "bunchee": "7.0.1",
    "eslint": "10.9.1",
    "jest": "30.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "next-themes": "^0.4.6",
    "@tanstack/react-query": "^5.104.1",
    "better-auth": "^1.7.7"
  },
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "input-otp": "^1.5.0",
    "react-day-picker": "^10.0.2",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.21.4",
    "@better-auth-ui/core": "^1.7.27",
    "@better-auth-ui/react": "^1.7.27",
    "@tanstack/react-form": "^1.33.5",
    "bowser": "^2.14.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.54.0"
  }
}
